# One initial staff account. Change the password before sharing or deploying.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Samadhan@2026!
# Citizen OTP is temporarily shown on screen; no SMS service is contacted.
# English AI: an OpenAI-compatible chat-completions endpoint.
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
# Vapi: PUBLIC key is intended for the browser; private API key is not required here.
VAPI_PUBLIC_KEY=
VAPI_ASSISTANT_ID=
# Set a long random value, and use the SAME value in a Vapi Bearer Token credential.
VAPI_WEBHOOK_SECRET=
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Used only by a non-NVIDIA OpenAI-compatible endpoint.
LLM_JSON_MODE=true
